<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.eclipse.txray</groupId>
		<artifactId>org.eclipse.txray.releng</artifactId>
		<version>1.0.0-SNAPSHOT</version>
		<relativePath>../../releng</relativePath>
	</parent>
	<artifactId>org.eclipse.txray.tests</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>eclipse-test-plugin</packaging>
	<properties>
		<h2.version>2.3.232</h2.version>
		<e2e.dir>${project.build.directory}/e2e</e2e.dir>
	</properties>
	<build>
		<plugins>
			<!-- The database of the debugged application -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.8.1</version>
				<executions>
					<execution>
						<id>copy-h2</id>
						<phase>process-test-classes</phase>
						<goals>
							<goal>copy</goal>
						</goals>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>com.h2database</groupId>
									<artifactId>h2</artifactId>
									<version>${h2.version}</version>
									<destFileName>h2.jar</destFileName>
								</artifactItem>
							</artifactItems>
							<outputDirectory>${e2e.dir}</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-surefire-plugin</artifactId>
				<version>${tycho.version}</version>
				<configuration>
					<!-- SWTBot drives a real workbench: it needs a display (xvfb-run on a server). -->
					<useUIHarness>true</useUIHarness>
					<useUIThread>false</useUIThread>
					<application>org.eclipse.ui.ide.workbench</application>
					<argLine>-Dtxray.e2e.classpath=${project.build.outputDirectory}${path.separator}${e2e.dir}/h2.jar -Dorg.eclipse.swtbot.screenshots.dir=${project.build.directory}/screenshots -Dorg.eclipse.swtbot.search.timeout=20000</argLine>
					<bundleStartLevel>
						<bundle>
							<id>org.apache.felix.scr</id>
							<level>2</level>
							<autoStart>true</autoStart>
						</bundle>
					</bundleStartLevel>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
